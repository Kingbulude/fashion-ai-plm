# ─── Supabase ───
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Cloudflare Workers AI ───
CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_AI_TOKEN=your-ai-token

# ─── AI Pipeline 内部调用密钥 ───
# AI Pipeline / Skill / Cron 调用 API 时使用此密钥（X-AI-Key header）
AI_API_KEY=generate-a-strong-random-string

# ─── 通信渠道（Phase 3） ───
# 飞书 Webhook（用于发消息、催进度）
LARK_WEBHOOK_URL=
# 企业微信 Webhook
WECHAT_WEBHOOK_URL=

# ─── 应用配置 ───
NODE_ENV=development

# ─── Storage（默认 Supabase Storage；配置 R2 后可切换） ───
# 可选值：supabase | r2（默认 supabase，向后兼容）
STORAGE_PROVIDER=supabase

# 当 STORAGE_PROVIDER=r2 时需要以下变量（R2 = Cloudflare 对象存储，S3 兼容）
# R2 ACCOUNT_ID 也可复用 CLOUDFLARE_ACCOUNT_ID
R2_ACCOUNT_ID=
# R2 API Token（需要 Object Read/Write 权限）
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
# R2 公网访问方式（任选其一，否则返回的 URL 不可直接访问）：
# 方式 1：绑定自定义域名（推荐 CNAME，走 Cloudflare CDN），如 https://cdn.example.com
R2_PUBLIC_BASE_URL=
# 方式 2：开通 r2.dev 子域名（临时用，不推荐生产），形如 https://xxx.r2.dev
R2_DEV_BASE_URL=
